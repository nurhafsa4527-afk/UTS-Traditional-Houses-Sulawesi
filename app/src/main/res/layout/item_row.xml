<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#EAF3E8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Card Mini untuk Gambar Rumah Adat (Rounded Square) -->
        <androidx.cardview.widget.CardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/tongkonan" />
        </androidx.cardview.widget.CardView>

        <!-- Informasi Teks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <!-- Judul Rumah Adat -->
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rumah Tongkonan"
                android:textColor="#1B3322"
                android:textSize="17sp"
                android:textStyle="bold"
                android:typeface="serif" />

            <!-- Deskripsi / Asal Daerah -->
            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Sulawesi Selatan - Rumah panggung ikonik Suku Toraja dengan atap melengkung seperti perahu."
                android:textColor="#3D5243"
                android:textSize="12sp"
                android:typeface="serif"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>